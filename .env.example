# feishubot 配置模板 —— 复制成 .env 放在【项目根目录】，填上真实值
#
#   cp .env.example .env    然后编辑 .env
#
# .env 已在 .gitignore 里，不会被提交、不会外传。

# ─────────────────────────────────────────────────────────────────────────────
# 规则（2026-09-17 定）：**手写的配置一律走本文件；机器人自己写的状态留在 json。**
#
#   手写的 → 本文件（.env）
#      密钥、凭据、推送地址、路径
#   机器人自己写的 → json（**不要手改**）
#      runtime_config.json  实盘开关 / 保证金 / 杠杆 / 监控群 / 读图方式…（可在群里发指令热加载）
#      state.json           持仓与游标
#      *.jsonl              成交、审计
#
# 为什么取消了 config.json：以前是「环境变量 > .env > config.json > 默认值」四层，
#   多一层来源就多一层“到底哪个赢了”的歧义 —— 而 `app` vs `feishu_app` 那个坑
#   （照模板填、令牌续期静默失败）本身就是“配置文件 + 键名”这套东西的产物。
#
# ⚠️ 缺了必备项会**启动失败并大声报错**（不会静默跑起来）。
#    这是提交 33c649b「无环境变量导致所有 AI 调用失败」的真正教训：
#    病根不是“文件还是环境变量”，而是**密钥缺失时静默降级成空字符串**。
# ─────────────────────────────────────────────────────────────────────────────

# ===== 路径（不填就用 /home/ubuntu/signal-bot）=====
# SIGNAL_BOT_BASE=/home/ubuntu/signal-bot

# ===== 必备：AI =====
# 信号解析全靠它；缺了 = 收不到信号
DEEPSEEK_API_KEY=

# ===== 必备：飞书推送地址（自定义机器人 webhook）=====
# 缺了 = 所有告警都发不出去 = 静默运行（本项目最忌讳的状态）
FEISHU_WEBHOOK=

# ===== 实盘时必须；影子模式只是读仓位做对账，缺了不阻断 =====
# 币安后台：只勾「合约交易」，**绝不开提现**，并绑定服务器出口 IP
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ===== API 取消息模式时必须（飞书用户令牌靠它自动续期）；回退 browser 模式则不需要 =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ===== 可选：成交统计写飞书多维表格 =====
# app_token = 多维表格 URL 里 /base/ 后面那串；table_id = URL 里 table= 后面那串
# 不配则只写日志，不影响交易
BITABLE_APP_TOKEN=
BITABLE_TABLE_ID=

# ===== 可选：其它 =====
# 飞书用户令牌文件位置（不填 = 与 feishu_api.py 同目录下的 feishu_user_token.json）
# FEISHU_TOKEN_PATH=/home/ubuntu/signal-bot/feishu_user_token.json
# 浏览器虚拟屏（API 模式用不到浏览器；回退 browser 模式才有用）
# DISPLAY=:99
# 静默开关：非空则**一条飞书都不发**（tools/ 里的离线工具与自检运行器会用）
# SIGNALBOT_SILENT=1
